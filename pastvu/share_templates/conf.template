; pastvu.conf для набора {name}.
; Положите этот файл в папку pastvu репозитория dataset_tools (рядом с run.bat)
; вместо того pastvu.conf, который сделал install.bat.

[paths]
; Папка, в которой лежит pastvu.db из архива. Фотографии появятся в ней же.
; Это единственная строка, которую нужно изменить.
base = D:\{name}

[defaults]
; Сколько фотографий скачивать одновременно. Предел задаёт сервер PastVu;
; больше 4 обычно не ускоряет.
fetchers = 4
