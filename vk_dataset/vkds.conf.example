; vkds configuration. install.bat copies this file to vkds.conf (next to vkds.py), which is yours to edit.
; Relative paths are resolved against the folder of this file.

[paths]
; The file with the VK access token. VK_TOKEN and --token take precedence over it.
token = vk_token.txt
; The datasets root: no --out writes here, a relative --out resolves under it, an absolute --out is used as it is.
base =
; The ledger of API calls of this checkout: daily attempts and successes, the limit hits, an optional reset_day.
ledger = _vkds\ledger.json

[limits]
; VK API calls per month of the application (CDN downloads do not count).
monthly = 10000
; Seconds between API calls (about 3 requests per second).
delay = 0.35
