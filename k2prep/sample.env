# k2prep --vl configuration. Copy this file to .env and edit it.
#
#   copy sample.env .env
#
# LOCAL SERVERS ONLY. k2prep never sends an Authorization header and has no
# option to add one. That is deliberate: there is no key to leak, no bill to run
# up, and no folder of photographs leaving the machine because a URL was wrong.
# A hosted endpoint will reject the unauthenticated request, which is the point.

# The OpenAI-compatible base URL of your local server. A trailing /v1 is added
# if you leave it off. Default ports:
#
#   llama.cpp (llama-server)   http://localhost:8080/v1
#   koboldcpp                  http://localhost:5001/v1
#   LM Studio                  http://localhost:1234/v1
#
# The server needs a VISION model loaded - a text-only model will answer, but it
# will be answering about nothing. For llama.cpp that means passing --mmproj
# alongside the model.
K2PREP_VL_ENDPOINT=http://localhost:8080/v1

# Model id to name in the request. llama.cpp and koboldcpp serve whatever is
# loaded and ignore this; LM Studio wants the identifier it shows in its UI.
# k2prep prints what the server reports at startup, so you can check.
K2PREP_VL_MODEL=local-model

# Seconds to wait for one reply. A 7B vision model on a GPU answers in a second
# or two; on CPU it can take a minute. Raise it rather than seeing timeouts.
K2PREP_VL_TIMEOUT=120
